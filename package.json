{
  "name": "clickup-gmail-chrome",
  "version": "1.2.3",
  "description": "Chrome extension to create ClickUp tasks from Gmail",
  "private": true,
  "author": "Leandro Iramain",
  "homepage": "https://leandroiramain.com.ar",
  "scripts": {
    "build": "tsc && node build.js",
    "build:sidecar": "node build.js --sidecar-only",
    "build:release": "npm run build && node scripts/build-release.js",
    "build:js": "node build.js",
    "validate:release": "node scripts/validate-release.js",
    "watch": "tsc -w & node build.js --watch",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.260",
    "esbuild": "^0.19.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "typescript": "^5.9.3"
  }
}
