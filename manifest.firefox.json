{
    "manifest_version": 3,
    "name": "TaskBridge for ClickUp",
    "version": "2.1.0",
    "description": "Integra Gmail y Meet con tareas y seguimiento de tiempo en ClickUp",
    "author": "Leandro Iramain",
    "homepage_url": "https://taskbridge.leandroiramain.com.ar/",
    "incognito": "not_allowed",
    "permissions": [
        "storage",
        "identity",
        "tabs",
        "alarms"
    ],
    "host_permissions": [
        "https://api.clickup.com/*",
        "https://mail.google.com/*",
        "https://app.clickup.com/*",
        "https://meet.google.com/*"
    ],
    "background": {
        "scripts": [
            "background.js"
        ]
    },
    "content_scripts": [
        {
            "matches": [
                "https://mail.google.com/*"
            ],
            "js": [
                "src/logger.js",
                "src/gmail-adapter.js",
                "src/gmail-native.js"
            ],
            "css": [
                "styles/gmail-native.css",
                "styles/modal.css"
            ],
            "run_at": "document_idle"
        },
        {
            "matches": [
                "https://app.clickup.com/*"
            ],
            "js": [
                "src/clickup-tracker.js"
            ],
            "run_at": "document_start"
        },
        {
            "matches": [
                "https://meet.google.com/*"
            ],
            "js": [
                "src/meet/meet-tracker.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "action": {
        "default_popup": "popup/minimal.html",
        "default_icon": {
            "16": "icons/icon-16.png",
            "32": "icons/icon-32.png",
            "48": "icons/icon-48.png",
            "128": "icons/icon-128.png"
        }
    },
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "web_accessible_resources": [
        {
            "resources": [
                "icons/*"
            ],
            "matches": [
                "https://mail.google.com/*"
            ]
        }
    ],
    "browser_specific_settings": {
        "gecko": {
            "id": "taskbridge-for-clickup@leandroiramain.com.ar",
            "strict_min_version": "140.0",
            "data_collection_permissions": {
                "required": [
                    "authenticationInfo",
                    "personalCommunications",
                    "personallyIdentifyingInfo",
                    "websiteActivity",
                    "websiteContent"
                ]
            }
        }
    }
}
